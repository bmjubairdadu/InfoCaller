<resources>
    <style name="Theme.InfoCaller" parent="android:Theme.Material.Light.NoActionBar">
        <!-- No window pre-background: the Compose launcher animation is the
             very first frame. Any windowBackground here flashes as a black
             screen before the animation starts, so it stays null. -->
        <item name="android:windowBackground">@null</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
